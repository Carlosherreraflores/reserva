# Copia este archivo como .env y completa los valores reales
# Para Railway/Render puedes usar DATABASE_URL directamente (reemplaza las variables individuales)

# Opción A — variables individuales (local o cualquier hosting)
DB_HOST=localhost
DB_USER=cabanas_user
DB_PASSWORD=tu_password_aqui
DB_NAME=cabanas_guanaquero
DB_PORT=5432

# Opción B — connection string (Railway, Render, Supabase, Neon, etc.)
# DATABASE_URL=postgresql://usuario:password@host:5432/nombre_db

PORT=3000

# ─────────────────────────────────────────────
# AUTENTICACIÓN JWT
# ─────────────────────────────────────────────
# Usuario administrador del panel web y la app
ADMIN_USERNAME=admin

# Hash bcrypt de la contraseña (generarlo con: node -e "const b=require('bcryptjs');console.log(b.hashSync('TU_PASSWORD',10))")
ADMIN_PASSWORD_HASH=$2b$10$REEMPLAZA_ESTE_VALOR_CON_EL_HASH_REAL

# Clave secreta para firmar los tokens JWT (usa una cadena larga y aleatoria)
JWT_SECRET=cambia_esto_por_una_clave_secreta_muy_larga_y_aleatoria

# Tiempo de expiración del token (7d = 7 días, 24h = 24 horas, etc.)
JWT_EXPIRES_IN=7d
